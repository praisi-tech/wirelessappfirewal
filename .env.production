# Application
APP_NAME="Crypto-WAF"
APP_ENV=production
APP_KEY=base64:UpXvOgYqZsUHzTSHQqPneSkpxVFO+vjxcI1HmXHvtfUm=
APP_DEBUG=false
APP_URL=https://crypto-waf.vercel.app

# Database (Use environment variables on Vercel)
DB_CONNECTION=mysql
DB_HOST=${DB_HOST}
DB_PORT=3306
DB_DATABASE=${DB_DATABASE}
DB_USERNAME=${DB_USERNAME}
DB_PASSWORD=${DB_PASSWORD}

# Cache
CACHE_DRIVER=array
SESSION_DRIVER=cookie
SESSION_LIFETIME=120

# Mail
MAIL_DRIVER=smtp
MAIL_HOST=${MAIL_HOST}
MAIL_PORT=587
MAIL_USERNAME=${MAIL_USERNAME}
MAIL_PASSWORD=${MAIL_PASSWORD}
MAIL_FROM_ADDRESS=noreply@crypto-waf.vercel.app
MAIL_FROM_NAME="Crypto-WAF"

# Security
SESSION_SECURE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
CSRF_TRUSTED_HOSTS=crypto-waf.vercel.app

# Logging
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# File Storage
FILESYSTEM_DRIVER=local

# Queue
QUEUE_CONNECTION=sync
