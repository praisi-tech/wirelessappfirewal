# Application
APP_NAME="Crypto-WAF"
APP_ENV=production
APP_KEY=base64:UpXvOgYqZsUHzTSHQqPneSkpxVFO+vjxcI1HmXHvtfUm=
APP_DEBUG=false
APP_URL=https://crypto-waf.vercel.app

# Frontend build base URL (Vite)
VITE_APP_URL=https://crypto-waf.vercel.app

# Database (Use Vercel environment variables)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crypto_waf
DB_USERNAME=root
DB_PASSWORD=

# Cache - Use array cache on Vercel
CACHE_DRIVER=array
CACHE_TTL=null
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_DOMAIN=crypto-waf.vercel.app
SESSION_SECURE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

# Mail
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=noreply@crypto-waf.vercel.app
MAIL_FROM_NAME="Crypto-WAF"

# Security
CSRF_TRUSTED_HOSTS=crypto-waf.vercel.app,*.vercel.app

# Logging
LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_STACK=single

# File Storage
FILESYSTEM_DRIVER=local

# Queue
QUEUE_CONNECTION=sync

# Redis (if available)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Security Settings
ENCRYPTION=AES-256-GCM
FORCE_HTTPS=true

