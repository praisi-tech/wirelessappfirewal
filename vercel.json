{
  "version": 2,
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "buildCommand": "npm ci && npm run build && composer install --no-dev --optimize-autoloader && php artisan optimize",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "routes": [
    {
      "src": "^/(favicon\\.ico|robots\\.txt|sitemap\\.xml)$",
      "dest": "/public/$1"
    },
    {
      "src": "^/build/(.*)$",
      "dest": "/public/build/$1"
    },
    {
      "src": "^/css/(.*)$",
      "dest": "/public/css/$1"
    },
    {
      "src": "^/js/(.*)$",
      "dest": "/public/js/$1"
    },
    {
      "src": "^/images/(.*)$",
      "dest": "/public/images/$1"
    },
    {
      "src": "^/storage/(.*)$",
      "dest": "/storage/$1"
    },
    {
      "src": "^/.*",
      "dest": "/api/index.php"
    }
  ]
}




